# .env.example — GAIN (Niaga Koin) frontend
# Base URL backend (termasuk prefix /api/v1 — lihat backend/.env API_BASE_PATH).
# Vite hanya membaca variabel berawalan VITE_ dan meng-inline-nya saat build,
# jadi JANGAN pernah menaruh secret di sini (nilainya publik di bundle browser).
VITE_API_BASE_URL=http://localhost:3000/api/v1
