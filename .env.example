# .env.example — GAIN (Niaga Koin)
# STATUS: skeleton dari Fase 0 discovery. Belum ada backend yang membaca variabel ini.
# Nilai akan dikonfirmasi/diisi nyata saat Fase 1 (Foundation) setelah stack final disepakati.
# JANGAN pernah commit file .env berisi nilai asli — hanya file .env.example ini yang boleh di-commit.

# --- App ---
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://gain_dev:changeme@localhost:5432/gain_dev

# --- Cache/Queue (Redis) — opsional, tergantung keputusan Fase 1 ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=changeme-generate-a-strong-random-secret
JWT_REFRESH_SECRET=changeme-generate-a-strong-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP registrasi & kebijakan lockout login (Fase 2). SRS menandai nilai
# pasti sebagai TBD (FR-AUTH-001, BR-ACC-001) — ini default aman yang bisa
# diubah tanpa mengubah kode.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- OTP delivery / Notifikasi (provider pengiriman nyata belum dikonfirmasi — TBD) ---
# Fase 2: OTP dikirim ke log aplikasi (dev only) lewat OtpProvider yang bisa
# diganti — lihat backend/src/auth/otp/. Belum terhubung ke provider nyata.
OTP_PROVIDER=TBD
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=

# --- Exchange Integration (Binance — dikonfirmasi sebagai exchange pertama) ---
# Kredensial exchange milik PENGGUNA disimpan terenkripsi di database, BUKAN di .env.
# Variabel di bawah hanya untuk konfigurasi koneksi ke market data publik.
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# --- Market Data (Fase 3) ---
# Simbol yang didukung — default mengikuti pasangan aset yang tampil di
# mockup desain (BTC/ETH/SOL). Belum ada keputusan cakupan final dari PO
# (SRS §6.1 menandai ini TBD) — ubah lewat env tanpa perlu ubah kode.
MARKET_DATA_SUPPORTED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKET_DATA_CACHE_TTL_MS=5000
MARKET_DATA_REQUEST_TIMEOUT_MS=5000
MARKET_DATA_MAX_RETRIES=2

# --- Exchange Account Connection (Fase 4) ---
# Kunci untuk mengenkripsi API key/secret exchange milik pengguna sebelum
# disimpan (AES-256-GCM). Wajib diisi — aplikasi menolak start tanpa ini.
# Boleh berupa passphrase apa pun (di-hash jadi kunci 32-byte), bukan harus
# byte mentah 32-karakter persis.
CREDENTIALS_ENCRYPTION_KEY=changeme-generate-a-strong-random-key
EXCHANGE_REQUEST_TIMEOUT_MS=5000
EXCHANGE_MAX_RETRIES=2

# --- Paper Trading (Fase 4b) ---
# Fee & slippage: master prompt mengizinkan "gunakan konfigurasi
# development yang terdokumentasi dan tandai sebagai TBD" saat belum ada
# keputusan bisnis final — ini itu. Model slippage sengaja sederhana
# (persentase tetap searah order, DETERMINISTIK agar test dapat
# direproduksi) — bukan simulasi depth order book yang lebih realistis
# (itu TBD, kandidat pengembangan lanjutan bila diperlukan).
PAPER_TRADING_DEFAULT_BALANCE_USDT=10000
PAPER_TRADING_FEE_PERCENT=0.1
PAPER_TRADING_SLIPPAGE_PERCENT=0.05
# Validasi order: nilai generik (bukan per-simbol seperti LOT_SIZE/
# MIN_NOTIONAL asli Binance — itu TBD, MVP pakai satu aturan untuk semua
# simbol yang didukung).
PAPER_TRADING_MIN_NOTIONAL_USDT=10
PAPER_TRADING_QUANTITY_PRECISION=6

# --- Bot Lifecycle (Fase 5a) ---
# Pengganti sementara untuk limit jumlah bot per tier langganan (F-SUB-01
# masih gap requirement — lihat FEATURE_MATRIX.md) — satu batas flat untuk
# semua pengguna sampai model bisnis langganan diputuskan.
MAX_BOTS_PER_USER=10

# Interval candle yang dipakai Strategy Engine saat POST /bots/{id}/evaluate
# (Fase 5b). Jumlah candle yang diminta otomatis mengikuti parameter RSI
# bot (period + 1), bukan dikonfigurasi di sini.
BOT_EVALUATE_CANDLE_INTERVAL=1h

# --- Feature Flags (keselamatan finansial) ---
LIVE_TRADING_ENABLED=false
